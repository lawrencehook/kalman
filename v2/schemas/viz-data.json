{
  "name": "VizData",
  "description": "Timestamped data package for visualization components",
  "required": ["groundTruth", "measurements", "estimates"],
  "properties": {
    "groundTruth": {
      "type": "array",
      "elementType": {
        "type": "object",
        "required": ["time", "position"],
        "properties": {
          "time": {
            "type": "number",
            "description": "Timestamp in seconds"
          },
          "position": {
            "type": "array",
            "length": 2,
            "elementType": "number",
            "description": "True 2D position [x, y]"
          }
        }
      },
      "description": "Array of timestamped ground truth positions"
    },
    "measurements": {
      "type": "array",
      "elementType": {
        "type": "object",
        "required": ["time", "position"],
        "properties": {
          "time": {
            "type": "number",
            "description": "Measurement timestamp in seconds"
          },
          "position": {
            "type": "array",
            "length": 2,
            "elementType": "number",
            "description": "Noisy 2D measurement [x, y]"
          }
        }
      },
      "description": "Array of timestamped measurements"
    },
    "estimates": {
      "type": "array",
      "elementType": {
        "type": "object",
        "required": ["time", "position", "covariance"],
        "properties": {
          "time": {
            "type": "number",
            "description": "Estimate timestamp in seconds"
          },
          "position": {
            "type": "array",
            "length": 2,
            "elementType": "number",
            "description": "Estimated 2D position [x, y]"
          },
          "covariance": {
            "type": "matrix",
            "dimensions": [2, 2],
            "elementType": "number",
            "description": "2x2 position covariance matrix"
          }
        }
      },
      "description": "Array of timestamped estimates with covariance"
    }
  }
}